{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "oae-reviewer": {
      "description": "OAE independent reviewer: read-only, runs validators, returns a verdict JSON.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "write",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "browser",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}