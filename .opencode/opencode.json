{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "oae-reviewer": {
      "description": "OAE independent reviewer: read-only, runs validators, returns a verdict JSON.",
      "mode": "subagent",
      "permission": {
        "*": "allow",
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "browser": "deny",
        "bash": {
          "*": "deny",
          "git status": "allow",
          "pwd": "allow",
          "ls": "allow",
          "npm test": "allow",
          "node --version": "allow"
        }
      }
    }
  }
}
