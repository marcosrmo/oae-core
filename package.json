{
  "name": "oae-core",
  "version": "0.1.0",
  "description": "OAE Core — Orchestrated Autonomous Engineering: an engine-agnostic harness CLI for AI-driven autonomous software engineering. First integrated engine: OpenCode v2.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "bin": { "oae": "./dist/index.js" },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test test/unit.test.ts",
    "test:unit": "node --test test/unit.test.ts",
    "test:integration": "node --test --test-timeout 900000 test/integration.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/index.ts"
  },
  "dependencies": {
    "@opencode/client": "2.0.29"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
